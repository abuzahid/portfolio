<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
    <link rel="stylesheet" href="/css/admin.css">
    <title>Admin — <%= blog ? 'Edit' : 'New' %> Blog Post</title>
</head>
<body class="admin-body">
    <aside class="admin-sidebar">
        <div class="admin-sidebar-header">
            <a href="/admin/dashboard" class="admin-logo">Admin Panel</a>
        </div>
        <nav class="admin-nav">
            <a href="/admin/dashboard" class="admin-nav-link">Dashboard</a>
            <a href="/admin/projects" class="admin-nav-link">Projects</a>
            <a href="/admin/blogs" class="admin-nav-link active">Blogs</a>
        </nav>
        <div class="admin-sidebar-footer">
            <a href="/" class="admin-nav-link" target="_blank">View Site</a>
            <form action="/admin/logout" method="POST" style="margin:0">
                <button type="submit" class="admin-nav-link admin-logout-btn">Logout</button>
            </form>
        </div>
    </aside>
    <main class="admin-main">
        <div class="admin-content">
            <h1 class="admin-page-title"><%= blog ? 'Edit' : 'New' %> Blog Post</h1>
            <form action="<%= blog ? '/admin/blogs/' + blog.id : '/admin/blogs' %>" method="POST" class="admin-form">
                <div class="form-group">
                    <label for="title">Title</label>
                    <input type="text" id="title" name="title" required value="<%= blog ? blog.title : '' %>">
                </div>
                <div class="form-group">
                    <label for="description">Description (short summary)</label>
                    <textarea id="description" name="description" rows="2" required><%= blog ? blog.description : '' %></textarea>
                </div>
                <div class="form-row-admin">
                    <div class="form-group">
                        <label for="date">Date</label>
                        <input type="text" id="date" name="date" value="<%= blog ? blog.date : new Date().getFullYear() %>" placeholder="e.g., 2024">
                    </div>
                    <div class="form-group">
                        <label for="tags">Tags (comma-separated)</label>
                        <input type="text" id="tags" name="tags" value="<%= blog ? blog.tags.join(', ') : '' %>">
                    </div>
                </div>
                <div class="form-group">
                    <label for="url">External URL (optional, for external blog posts)</label>
                    <input type="url" id="url" name="url" value="<%= blog ? (blog.url || '') : '' %>" placeholder="https://...">
                </div>
                <div class="form-group">
                    <label for="content">Content (Markdown)</label>
                    <textarea id="content" name="content" rows="15" class="admin-markdown"><%= blog ? (blog.content || '') : '' %></textarea>
                </div>
                <div class="form-group form-check">
                    <label>
                        <input type="checkbox" name="published" <%= !blog || blog.published !== false ? 'checked' : '' %>>
                        Published
                    </label>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary"><%= blog ? 'Update' : 'Create' %> Post</button>
                    <a href="/admin/blogs" class="btn btn-outline">Cancel</a>
                </div>
            </form>
        </div>
    </main>
</body>
</html>
