<% var pageTitle = 'Projects'; var active = 'projects'; %>
<%- include('../partials/admin-layout', { body: `
    <div class="admin-header-row">
        <h1 class="admin-page-title">Projects</h1>
        <a href="/admin/projects/new" class="btn btn-primary btn-sm">+ New Project</a>
    </div>
    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Date</th>
                    <th>Featured</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                ${projects.map(p => `
                    <tr>
                        <td>${p.title}</td>
                        <td><span class="admin-badge">${p.category}</span></td>
                        <td>${p.date}</td>
                        <td>${p.featured ? '&#9733;' : ''}</td>
                        <td class="admin-actions">
                            <a href="/admin/projects/${p.id}/edit" class="btn btn-sm btn-outline">Edit</a>
                            <form action="/admin/projects/${p.id}/delete" method="POST" onsubmit="return confirm('Delete this project?')" style="display:inline">
                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                `).join('')}
            </tbody>
        </table>
    </div>
` }) %>
